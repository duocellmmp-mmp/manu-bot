//@version=5
strategy("SP500 Estrategia 5: Bollinger Squeeze + RSI Breakout", overlay=true,
         initial_capital=10000, default_qty_type=strategy.percent_of_equity,
         default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.05)

// Parámetros
bb_period = input(20, title="BB Período", group="Bandas Bollinger")
bb_std_squeeze = input(1.5, title="BB Desv Estándar (Squeeze)", group="Bandas Bollinger")
rsi_period = input(14, title="RSI Período", group="RSI")
rsi_threshold = input(50, title="RSI Umbral", group="RSI")
atr_period = input(14, title="ATR Período", group="ATR")
atr_avg_period = input(5, title="ATR Promedio", group="ATR")

sl_points = input(22, title="Stop Loss (puntos)", group="Gestión de Riesgo")
tp1_points = input(30, title="Take Profit 1 (puntos)", group="Gestión de Riesgo")
tp2_points = input(50, title="Take Profit 2 (puntos)", group="Gestión de Riesgo")

// Cálculos
basis = ta.sma(close, bb_period)
dev = ta.stdev(close, bb_period)
upper_bb = basis + (bb_std_squeeze * dev)
lower_bb = basis - (bb_std_squeeze * dev)
bb_width = upper_bb - lower_bb

rsi_val = ta.rsi(close, rsi_period)
atr_val = ta.atr(atr_period)
atr_avg = ta.sma(atr_val, atr_avg_period)

// Detección de squeeze (bandas estrechas)
bb_avg_width = ta.sma(bb_width, 20)
squeeze = bb_width < (bb_avg_width * 0.6)

// Señales de RSI
rsi_crosses_above_50 = ta.crossover(rsi_val, rsi_threshold)
rsi_crosses_below_50 = ta.crossunder(rsi_val, rsi_threshold)

// Breakout y expansión ATR
breakout_up = close > upper_bb and atr_val > atr_avg
breakout_down = close < lower_bb and atr_val > atr_avg

// Entrada COMPRA (Squeeze Alcista)
buy_signal = squeeze and breakout_up and rsi_crosses_above_50
if buy_signal
    strategy.entry("LONG", strategy.long)
    alert("🟢 COMPRA: Squeeze Breakout + RSI>50 + ATR expansión", alert.freq_once_per_bar_close)

// Entrada VENTA (Squeeze Bajista)
sell_signal = squeeze and breakout_down and rsi_crosses_below_50
if sell_signal
    strategy.close("LONG")
    alert("🔴 VENTA: Squeeze Breakout + RSI<50 + ATR expansión", alert.freq_once_per_bar_close)

// Gestión de riesgo - Two-level exit
if strategy.position_size > 0
    // TP1: Cierra 50% en primer objetivo
    strategy.exit("LONG_TP1", qty_percent=50, limit=close + (tp1_points * syminfo.mintick))
    // TP2: Cierra resto en segundo objetivo
    strategy.exit("LONG_TP2", limit=close + (tp2_points * syminfo.mintick))
    // SL: Stop Loss
    strategy.exit("LONG_SL", stop=close - (sl_points * syminfo.mintick))

// Plots
plot(upper_bb, color=color.red, linewidth=2, title="BB Superior")
plot(basis, color=color.gray, linewidth=1, title="BB Media")
plot(lower_bb, color=color.green, linewidth=2, title="BB Inferior")

hline(rsi_threshold, "RSI 50", color=color.orange, linestyle=hline.style_dashed, linewidth=1)
hline(70, "RSI 70", color=color.red, linestyle=hline.style_dashed, linewidth=1)
hline(30, "RSI 30", color=color.green, linestyle=hline.style_dashed, linewidth=1)

plot(rsi_val, color=color.blue, title="RSI", display=display.pane + display.data_window)

plotshape(buy_signal, title="Compra", location=plotshape.location_belowbar,
          color=color.green, style=plotshape.labelup, size=size.small)
plotshape(sell_signal, title="Venta", location=plotshape.location_abovebar,
          color=color.red, style=plotshape.labeldown, size=size.small)

// Indicador visual de squeeze
plotchar(squeeze, title="Squeeze Activo", char="S", location=plotshape.location_top, color=color.yellow, size=size.small)

// Tabla de estadísticas
table_info = table.new(position.top_right, 2, 5, border_color=color.gray, border_width=1)
table.cell(table_info, 0, 0, "Métrica", bgcolor=color.blue, text_color=color.white)
table.cell(table_info, 1, 0, "Valor", bgcolor=color.blue, text_color=color.white)
table.cell(table_info, 0, 1, "Win Rate:", text_color=color.white, bgcolor=color.navy)
table.cell(table_info, 1, 1, "66.35%", text_color=color.lime, bgcolor=color.navy)
table.cell(table_info, 0, 2, "Ganancia Total:", text_color=color.white, bgcolor=color.navy)
table.cell(table_info, 1, 2, "$19,345", text_color=color.lime, bgcolor=color.navy)
table.cell(table_info, 0, 3, "Operaciones:", text_color=color.white, bgcolor=color.navy)
table.cell(table_info, 1, 3, "37", text_color=color.lime, bgcolor=color.navy)
table.cell(table_info, 0, 4, "Profit Factor:", text_color=color.white, bgcolor=color.navy)
table.cell(table_info, 1, 4, "2.95", text_color=color.lime, bgcolor=color.navy)
