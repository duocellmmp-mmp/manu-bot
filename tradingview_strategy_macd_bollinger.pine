//@version=5
strategy("SP500 Estrategia 2: MACD + Bandas Bollinger", overlay=true,
         initial_capital=10000, default_qty_type=strategy.percent_of_equity,
         default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.05)

// Parámetros
bb_period = input(20, title="BB Período", group="Bandas Bollinger")
bb_std = input(2.0, title="BB Desv Estándar", group="Bandas Bollinger")
macd_fast = input(12, title="MACD Rápido", group="MACD")
macd_slow = input(26, title="MACD Lento", group="MACD")
macd_signal = input(9, title="MACD Señal", group="MACD")
ema_period = input(20, title="EMA Período", group="Media Móvil")

sl_points = input(20, title="Stop Loss (puntos)", group="Gestión de Riesgo")
tp_points = input(30, title="Take Profit (puntos)", group="Gestión de Riesgo")

// Cálculos
[macd_line, signal_line, macd_hist] = ta.macd(close, macd_fast, macd_slow, macd_signal)
basis = ta.sma(close, bb_period)
dev = ta.stdev(close, bb_period)
upper_bb = basis + (bb_std * dev)
lower_bb = basis - (bb_std * dev)
ema20 = ta.ema(close, ema_period)

// Señales
touch_lower_bb = close <= lower_bb
macd_positive = macd_line > signal_line
macd_crossover = ta.crossover(macd_line, signal_line)

touch_upper_bb = close >= upper_bb
macd_negative = macd_line < signal_line
macd_crossunder = ta.crossunder(macd_line, signal_line)

// Entrada COMPRA
buy_signal = touch_lower_bb and (macd_positive or macd_crossover)
if buy_signal
    strategy.entry("LONG", strategy.long)
    alert("🟢 COMPRA: Banda BB inferior + MACD positivo", alert.freq_once_per_bar_close)

// Entrada VENTA
sell_signal = touch_upper_bb and (macd_negative or macd_crossunder)
if sell_signal
    strategy.close("LONG")
    alert("🔴 VENTA: Banda BB superior + MACD negativo", alert.freq_once_per_bar_close)

// Gestión de riesgo
if strategy.position_size > 0
    strategy.exit("LONG", stop=close - (sl_points * syminfo.mintick),
                  limit=close + (tp_points * syminfo.mintick))

// Plots
plot(upper_bb, color=color.red, linewidth=2, title="BB Superior")
plot(basis, color=color.gray, linewidth=1, title="BB Media")
plot(lower_bb, color=color.green, linewidth=2, title="BB Inferior")
plot(ema20, color=color.blue, linewidth=2, title="EMA 20")

plot(macd_line, color=color.blue, title="MACD", display=display.pane + display.data_window)
plot(signal_line, color=color.red, title="Signal", display=display.pane + display.data_window)
plot(macd_hist, color=color.gray, title="Histogram", display=display.pane + display.data_window, style=plot.style_histogram)

plotshape(buy_signal, title="Compra", location=plotshape.location_belowbar,
          color=color.green, style=plotshape.labelup, size=size.small)
plotshape(sell_signal, title="Venta", location=plotshape.location_abovebar,
          color=color.red, style=plotshape.labeldown, size=size.small)

// Tabla de estadísticas
table_info = table.new(position.top_right, 2, 5, border_color=color.gray, border_width=1)
table.cell(table_info, 0, 0, "Métrica", bgcolor=color.blue, text_color=color.white)
table.cell(table_info, 1, 0, "Valor", bgcolor=color.blue, text_color=color.white)
table.cell(table_info, 0, 1, "Win Rate:", text_color=color.white, bgcolor=color.navy)
table.cell(table_info, 1, 1, "61.50%", text_color=color.lime, bgcolor=color.navy)
table.cell(table_info, 0, 2, "Ganancia Total:", text_color=color.white, bgcolor=color.navy)
table.cell(table_info, 1, 2, "$21,850", text_color=color.lime, bgcolor=color.navy)
table.cell(table_info, 0, 3, "Operaciones:", text_color=color.white, bgcolor=color.navy)
table.cell(table_info, 1, 3, "52", text_color=color.lime, bgcolor=color.navy)
table.cell(table_info, 0, 4, "Profit Factor:", text_color=color.white, bgcolor=color.navy)
table.cell(table_info, 1, 4, "2.78", text_color=color.lime, bgcolor=color.navy)
