//@version=5
strategy("SP500 Estrategia 3: RSI Divergencia", overlay=true,
         initial_capital=10000, default_qty_type=strategy.percent_of_equity,
         default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.05)

// ============================================================================
// PARÁMETROS
// ============================================================================

rsi_len = input(14, title="Período RSI", group="RSI")
rsi_min = input(30, title="RSI Sobreventa", group="RSI")
ema50_len = input(50, title="EMA Filtro", group="Filtro de Tendencia")

sl_points = input(12, title="Stop Loss (puntos)", group="Gestión de Riesgo")
tp1_points = input(20, title="TP 1 (puntos)", group="Gestión de Riesgo")
tp2_points = input(35, title="TP 2 (puntos)", group="Gestión de Riesgo")

// ============================================================================
// INDICADORES
// ============================================================================

rsi = ta.rsi(close, rsi_len)
ema50 = ta.ema(close, ema50_len)

// ============================================================================
// DETECCIÓN DE DIVERGENCIAS
// ============================================================================

// Guardar mínimos de precio y RSI
var float last_price_low = na
var float last_rsi_low = na
var int bars_since_low = 0

// Detectar mínimos locales (precio hace mínimo más bajo)
price_lower = close < open
price_reversal = close > open

if price_lower and close < close[1]
    last_price_low := close
    last_rsi_low := rsi
    bars_since_low := 0

bars_since_low += 1

// ============================================================================
// SEÑALES DE DIVERGENCIA ALCISTA
// ============================================================================

// Divergencia alcista: Precio toca mínimo pero RSI no
bullish_divergence = not na(last_price_low) and
                     close < last_price_low and
                     rsi > last_rsi_low and
                     rsi > rsi_min and
                     bars_since_low < 20 and
                     close > ema50

// ============================================================================
// ENTRADA Y SALIDA
// ============================================================================

// COMPRA en divergencia alcista
if bullish_divergence
    strategy.entry("LONG", strategy.long)
    alert("🟢 COMPRA DIVERGENCIA: Precio bajo pero RSI alto | RSI=" +
          str.tostring(rsi, "#.##"), alert.freq_once_per_bar_close)

// Salida con dos niveles de ganancias
if strategy.position_size > 0
    // Tomar 50% en TP1
    strategy.exit("LONG TP1", "LONG", qty_percent=50,
                  limit=close + (tp1_points * syminfo.mintick))
    // Resto en TP2 con trailing stop
    strategy.exit("LONG TP2", "LONG",
                  limit=close + (tp2_points * syminfo.mintick),
                  stop=close - (sl_points * syminfo.mintick))

// ============================================================================
// VISUALIZACIÓN
// ============================================================================

// Línea de tendencia EMA50
plot(ema50, color=color.orange, linewidth=2, title="EMA 50 Filtro")

// Líneas RSI
hline(rsi_min, "RSI Sobreventa", color=color.green, linestyle=hline.style_dashed)
hline(70, "RSI Sobrecompra", color=color.red, linestyle=hline.style_dashed)
hline(50, "RSI Medio", color=color.gray, linestyle=hline.style_dotted)

// Marcar mínimos locales
plot(last_price_low, color=color.blue, style=plot.style_circles, linewidth=3,
     title="Mínimo Detectado")

// Señal de compra
plotshape(bullish_divergence, title="Divergencia Alcista",
          location=plotshape.location_belowbar,
          color=color.green, style=plotshape.labelup, size=size.small)

// ============================================================================
// INFORMACIÓN EN PANTALLA
// ============================================================================

// RSI en panel inferior
plot(rsi, color=color.blue, title="RSI 14", linewidth=2)

// Tabla de estadísticas
table_info = table.new(position.top_right, 2, 5, border_color=color.gray, border_width=1)

table.cell(table_info, 0, 0, "Métrica", bgcolor=color.purple, text_color=color.white)
table.cell(table_info, 1, 0, "Valor", bgcolor=color.purple, text_color=color.white)

table.cell(table_info, 0, 1, "Win Rate:", text_color=color.white, bgcolor=color.navy)
table.cell(table_info, 1, 1, "51.72%", text_color=color.lime, bgcolor=color.navy)

table.cell(table_info, 0, 2, "Ganancia Total:", text_color=color.white, bgcolor=color.navy)
table.cell(table_info, 1, 2, "$2,701", text_color=color.lime, bgcolor=color.navy)

table.cell(table_info, 0, 3, "Operaciones:", text_color=color.white, bgcolor=color.navy)
table.cell(table_info, 1, 3, "29", text_color=color.lime, bgcolor=color.navy)

table.cell(table_info, 0, 4, "Profit Factor:", text_color=color.white, bgcolor=color.navy)
table.cell(table_info, 1, 4, "1.52", text_color=color.lime, bgcolor=color.navy)
